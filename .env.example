# Frontend (exposed to the browser via Vite)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Backend (API handlers in /api, run by the Cloudflare Worker). SUPABASE_URL and
# SUPABASE_ANON_KEY are set in wrangler.jsonc; the service role key is a Worker
# secret. For local `npm run dev:worker`, put them in .dev.vars instead.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
